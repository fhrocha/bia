{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<2",
        "postgres-mcp",
        "postgresql://postgres:postgres@localhost:5433/bia"
      ],
      "enabled": true
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "enabled": true
    }
  }
}
